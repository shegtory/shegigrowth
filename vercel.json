{
  "version": 2,
  "builds": [
    {
      "src": "api/webhook.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["api/**"] }
    },
    {
      "src": "api/targets.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["api/**"] }
    },
    {
      "src": "api/stats.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["api/**"] }
    },
    {
      "src": "api/done.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["api/**"] }
    },
    {
      "src": "api/cron.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["api/**"] }
    },
    { "src": "index.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/webhook", "dest": "/api/webhook.py" },
    { "src": "/api/targets", "dest": "/api/targets.py" },
    { "src": "/api/stats", "dest": "/api/stats.py" },
    { "src": "/api/done", "dest": "/api/done.py" },
    { "src": "/api/cron", "dest": "/api/cron.py" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
